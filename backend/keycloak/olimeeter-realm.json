{
  "realm": "olimeeter",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user who can request fuel dispensing"
      },
      {
        "name": "supervisor",
        "description": "Supervisor with elevated quota limits"
      },
      {
        "name": "admin",
        "description": "Administrator with full system access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "olimeeter-app",
      "name": "OliMeeter Application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*",
        "olimeeter://callback/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@olimeeter.com",
      "firstName": "System",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "alice_supervisor",
      "email": "alice@olimeeter.com",
      "firstName": "Alice",
      "lastName": "Johnson",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["supervisor"]
    },
    {
      "username": "bob_driver",
      "email": "bob@olimeeter.com",
      "firstName": "Bob",
      "lastName": "Smith",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "carol_operator",
      "email": "carol@olimeeter.com",
      "firstName": "Carol",
      "lastName": "Davis",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
